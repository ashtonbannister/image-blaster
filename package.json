{
  "name": "image-blaster-workspace",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "start": "node chatgpt/server.mjs",
    "dev:chatgpt": "node chatgpt/server.mjs",
    "test:chatgpt": "node --test chatgpt/test/*.test.mjs",
    "dev": "bun --cwd=app run dev",
    "build": "bun --cwd=app run build",
    "preview": "bun --cwd=app run preview",
    "test": "bun --cwd=app run test",
    "typecheck": "bun --cwd=app run typecheck"
  }
}
